# Set these in the shell before starting Spring Boot. Spring does not load .env automatically.
# Local PostgreSQL settings. Render injects DATABASE_URL from its Postgres service.
DB_URL=jdbc:postgresql://localhost:5432/task_manager?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-postgres-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
