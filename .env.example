# Set these in the shell before starting Spring Boot. Spring does not load .env automatically.
DB_URL=jdbc:mysql://localhost:3306/task_manager?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=15
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
